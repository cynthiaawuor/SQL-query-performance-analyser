# Copy to .env and fill in. All of these can also be passed as CLI flags —
# see src/cli/args.ts. CLI flags take precedence over these when both are set.

DATABASE_URL=postgres://user:password@localhost:5432/dbname
COST_THRESHOLD=1000
MIN_ROWS_EXAMINED=1000
MAX_ROWS_RETURNED=10
SMALL_TABLE_ROW_THRESHOLD=100
